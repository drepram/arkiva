DATABASE_URL=postgres://user:pass@127.0.0.1:5432/arkiva
PAYLOAD_SECRET=replace-with-a-long-random-value
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When using Kabe-style LOCAL_DATABASE_URL/SERVER_DATABASE_URL variables,
# Arkiva reuses the credentials but selects this separate database.
ARKIVA_DATABASE_NAME=arkiva

# Keep true for local development to store uploads in ./media.
DISABLE_R2=true
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
R2_PREFIX=arkiva

# CSV used by `pnpm import:artefacts`.
ARTEFACTS_CSV=
ARTEFAKKITA_SITE_DIR=/absolute/path/to/artefakkita-site
